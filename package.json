{
  "name": "cqx-kit",
  "version": "0.6.1",
  "description": "The shared engine behind cqx.bio and the deka explorer: one answer to what a default is, and one set of shapes for what cqx emits.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samifouad/cqx-kit.git"
  },
  "homepage": "https://cqx.bio",
  "bugs": "https://github.com/samifouad/cqx-kit/issues",
  "keywords": [
    "cqx",
    "rust",
    "code-quality",
    "static-analysis"
  ],
  "sideEffects": [
    "./dist/workers/*.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./workers/analyse": {
      "types": "./dist/workers/analyse.d.ts",
      "default": "./dist/workers/analyse.js"
    },
    "./workers/read": {
      "types": "./dist/workers/read.d.ts",
      "default": "./dist/workers/read.js"
    },
    "./gh": {
      "types": "./dist/gh/index.d.ts",
      "default": "./dist/gh/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node tests/rank.mjs && node tests/catalog.mjs && node tests/gh.mjs && node tests/source.mjs && node tests/store.mjs && node tests/diff.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
