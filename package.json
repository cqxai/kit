{
  "name": "@cqxai/kit",
  "version": "0.8.2",
  "description": "The shared engine behind cqx.dev and the deka explorer: one answer to what a default is, and one set of shapes for what cqx emits.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqxai/kit.git"
  },
  "homepage": "https://cqx.dev",
  "bugs": "https://github.com/cqxai/kit/issues",
  "keywords": [
    "cqx",
    "rust",
    "code-quality",
    "static-analysis"
  ],
  "sideEffects": [
    "./dist/workers/*.js",
    "./dist/brand/brand.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "default": "./dist/brand/index.js"
    },
    "./brand/brand.css": "./dist/brand/brand.css",
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./theme/server": {
      "types": "./dist/theme/server.d.ts",
      "default": "./dist/theme/server.js"
    },
    "./workers/analyse": {
      "types": "./dist/workers/analyse.d.ts",
      "default": "./dist/workers/analyse.js"
    },
    "./workers/read": {
      "types": "./dist/workers/read.d.ts",
      "default": "./dist/workers/read.js"
    },
    "./gh": {
      "types": "./dist/gh/index.d.ts",
      "default": "./dist/gh/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "brand": "node src/brand/generate.ts",
    "brand:check": "node src/brand/generate.ts --check",
    "build": "npm run brand:check && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node tests/brand.mjs && node tests/rank.mjs && node tests/catalog.mjs && node tests/gh.mjs && node tests/source.mjs && node tests/store.mjs && node tests/diff.mjs && node tests/theme.mjs && node tests/wrap.mjs && node tests/consumer.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
